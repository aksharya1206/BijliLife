PROJECT_NAME="BijliLiFE Citizen Energy Platform"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Database (PostgreSQL with asyncpg or fallback SQLite with aiosqlite)
# For local zero-setup dev, use: sqlite+aiosqlite:///./bijlilife.db
# For production docker/Postgres: postgresql+asyncpg://bijlilife_user:bijlilife_secret_password@localhost:5432/bijlilife_db
DATABASE_URL=sqlite+aiosqlite:///./bijlilife.db

# OpenWeather API (For solar irradiance & ambient temperature modeling)
# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
